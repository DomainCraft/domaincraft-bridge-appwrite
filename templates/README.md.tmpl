{{- range $e := .Project.Entities }}{{ if eq $e.Name $.Project.Auth.Entity }}{{ range $f := $e.Fields }}{{ if eq (lower $f.Name) "role" }}{{ if $f.DefaultValue }}{{ $defaultRole = $f.DefaultValue }}{{ end }}{{ end }}{{ end }}{{ end }}{{ end }}
